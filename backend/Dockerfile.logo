# Atualiza SÓ as 4 páginas legais (logo do pégaso no lugar do "V"). Parte da 2.99 que
# já roda → preserva front-end, backend, node_modules byte a byte.
FROM vertice-api:2.99
COPY politica-de-seguranca.html   /app/public/politica-de-seguranca.html
COPY termos.html                  /app/public/termos.html
COPY excluir-conta.html           /app/public/excluir-conta.html
COPY excluir-dados.html           /app/public/excluir-dados.html
