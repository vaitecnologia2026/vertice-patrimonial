const express = require('express');
const prisma = require('../utils/prisma');
const { auth, adminOnly } = require('../middleware/auth');

const router = express.Router();

const VALID_STATUS = ['PENDENTE', 'APROVADO', 'PAGO', 'CANCELADO'];

function calcularPayout(parceiro, valorBase) {
  const v = parseFloat(valorBase) || 0;
  if (parceiro.tipoComissao === 'PERCENTUAL') {
    return Math.round((v * (parseFloat(parceiro.valComissao) || 0) / 100) * 100) / 100;
  }
  return parseFloat(parceiro.valComissao) || 0;
}

// ─── LIST ────────────────────────────────────────────────────
router.get('/', auth, async (req, res, next) => {
  try {
    const where = {};
    if (req.user.role === 'LIC') where.licId = req.user.licId;
    else if (req.query.licId) where.licId = req.query.licId;
    if (req.query.parceiroId) where.parceiroId = req.query.parceiroId;
    if (req.query.status) {
      const s = String(req.query.status).toUpperCase();
      if (VALID_STATUS.includes(s)) where.status = s;
    }
    const list = await prisma.partnerPayout.findMany({
      where,
      include: {
        parceiro: { select: { id: true, nome: true, tipoComissao: true, valComissao: true, regraComissao: true } },
        lead:     { select: { id: true, nomeCliente: true, status: true } },
      },
      orderBy: { createdAt: 'desc' },
    });
    res.json(list);
  } catch (err) { next(err); }
});

// ─── RESUMO ──────────────────────────────────────────────────
router.get('/resumo', auth, async (req, res, next) => {
  try {
    const where = req.user.role === 'LIC'
      ? { licId: req.user.licId }
      : (req.query.licId ? { licId: req.query.licId } : {});
    const [aPagar, pagos, byParceiro] = await Promise.all([
      prisma.partnerPayout.aggregate({ _sum: { valorCalculado: true }, where: { ...where, status: { in: ['PENDENTE', 'APROVADO'] } } }),
      prisma.partnerPayout.aggregate({ _sum: { valorCalculado: true }, where: { ...where, status: 'PAGO' } }),
      prisma.partnerPayout.groupBy({
        by: ['parceiroId', 'status'],
        _sum: { valorCalculado: true },
        _count: { _all: true },
        where,
      }),
    ]);
    res.json({
      totalAPagar: aPagar._sum.valorCalculado || 0,
      totalPago:   pagos._sum.valorCalculado || 0,
      porParceiro: byParceiro,
    });
  } catch (err) { next(err); }
});

// ─── CREATE manual ───────────────────────────────────────────
router.post('/', auth, async (req, res, next) => {
  try {
    const { parceiroId, leadId, valorBase, obs } = req.body || {};
    if (!parceiroId) return res.status(400).json({ error: 'parceiroId é obrigatório.' });
    if (valorBase == null) return res.status(400).json({ error: 'valorBase é obrigatório.' });

    const parc = await prisma.parceiro.findUnique({ where: { id: parceiroId } });
    if (!parc) return res.status(404).json({ error: 'Parceiro não encontrado.' });
    if (req.user.role === 'LIC' && parc.licId !== req.user.licId) {
      return res.status(403).json({ error: 'Acesso negado ao parceiro.' });
    }
    if (parc.status !== 'ATIVO') return res.status(400).json({ error: 'Parceiro não está ativo.' });

    if (leadId) {
      const lead = await prisma.partnerLead.findUnique({ where: { id: leadId } });
      if (!lead || lead.parceiroId !== parc.id) {
        return res.status(400).json({ error: 'Lead inválido para este parceiro.' });
      }
    }

    const valorCalculado = calcularPayout(parc, valorBase);
    const payout = await prisma.partnerPayout.create({
      data: {
        parceiroId: parc.id,
        licId: parc.licId,
        leadId: leadId || null,
        valorBase: parseFloat(valorBase),
        tipoComissao: parc.tipoComissao,
        regraComissao: parc.regraComissao,
        valorCalculado,
        obs: obs ? String(obs).slice(0, 500) : null,
      },
      include: {
        parceiro: { select: { id: true, nome: true } },
        lead:     { select: { id: true, nomeCliente: true } },
      },
    });

    await prisma.auditoria.create({
      data: {
        userId: req.user.id, action: 'PAYOUT_CRIADO', entity: 'PartnerPayout', entityId: payout.id,
        desc: `Repasse de ${valorCalculado} para parceiro ${parc.nome}`, ip: req.ip,
      },
    });

    res.status(201).json(payout);
  } catch (err) { next(err); }
});

// ─── STATUS ──────────────────────────────────────────────────
router.patch('/:id/status', auth, async (req, res, next) => {
  try {
    const existing = await prisma.partnerPayout.findUnique({ where: { id: req.params.id } });
    if (!existing) return res.status(404).json({ error: 'Repasse não encontrado.' });
    if (req.user.role === 'LIC' && existing.licId !== req.user.licId) {
      return res.status(403).json({ error: 'Acesso negado.' });
    }
    const novo = String(req.body.status || '').toUpperCase();
    if (!VALID_STATUS.includes(novo)) return res.status(400).json({ error: 'status inválido.' });

    const data = { status: novo };
    if (novo === 'PAGO') {
      data.pagoEm = new Date();
      data.pagoBy = req.user.id;
    }
    const updated = await prisma.partnerPayout.update({ where: { id: existing.id }, data });

    await prisma.auditoria.create({
      data: { userId: req.user.id, action: 'PAYOUT_STATUS', entity: 'PartnerPayout', entityId: updated.id, desc: `Status → ${novo}`, ip: req.ip },
    });

    res.json(updated);
  } catch (err) { next(err); }
});

// ─── DELETE ──────────────────────────────────────────────────
router.delete('/:id', auth, adminOnly, async (req, res, next) => {
  try {
    await prisma.partnerPayout.delete({ where: { id: req.params.id } });
    res.json({ ok: true });
  } catch (err) { next(err); }
});

module.exports = router;
